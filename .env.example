TAPO_USERNAME=your-tapo-cloud-email
TAPO_PASSWORD=your-tapo-cloud-password
FUSEBOX_BIND=127.0.0.1:8787
FUSEBOX_REFRESH_SECONDS=10
FUSEBOX_SCAN_SECONDS=60
FUSEBOX_ENERGY_PRICE_PENCE_PER_KWH=27.03
FUSEBOX_DISCOVERY_TIMEOUT_SECONDS=5
# Comma or space separated IPv4 addresses/CIDRs to scan instead of auto-detected container interfaces.
# FUSEBOX_DISCOVERY_TARGETS=192.168.0.0/24
# FUSEBOX_STATE_PATH=/home/kieran/.config/fusebox/state.json
# RUST_LOG=info

# Required only for compose.macvlan.example.yml.
# FUSEBOX_DATA_DIR=/srv/fusebox-data
# FUSEBOX_INTRANET_IP=10.10.0.30
# FUSEBOX_LAN_PARENT=enp42s0
# FUSEBOX_LAN_IP=192.168.0.50
# FUSEBOX_LAN_SUBNET=192.168.0.0/24
# FUSEBOX_LAN_GATEWAY=192.168.0.1
# FUSEBOX_LAN_IP_RANGE=192.168.0.48/28
